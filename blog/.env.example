# The blog needs a project of your own and an IP write key: the key a live site
# ships. From an address on the key's allowlist the blog registers each new post
# itself; from anywhere else it is read-only and reports the post's address so
# Langsys can visit the page (that visit needs the blog on a public URL, which
# localhost is not).
VITE_LANGSYS_PROJECT_ID=your-project-id-here
VITE_LANGSYS_API_KEY=your-ip-write-key-here

# Optional: point the SDK at a non-production instance for local development.
# VITE_LANGSYS_API_URL=http://langsys-nova.test/api

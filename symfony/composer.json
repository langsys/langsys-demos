{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "langsys/symfony-starter",
    "type": "project",
    "description": "Langsys × Symfony demo — realtime, continuous translation with the t() Twig function.",
    "keywords": ["symfony", "langsys", "i18n", "localization", "demo"],
    "license": "MIT",
    "repositories": [
        { "type": "vcs", "url": "https://github.com/langsys/langsys-symfony" },
        { "type": "vcs", "url": "https://github.com/langsys/langsys-php" }
    ],
    "require": {
        "php": "^8.2",
        "langsys/symfony-sdk": "dev-main",
        "symfony/console": "^7.3",
        "symfony/dotenv": "^7.3",
        "symfony/framework-bundle": "^7.3",
        "symfony/twig-bundle": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

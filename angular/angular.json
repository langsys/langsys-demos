{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "projects": {
        "langsys-angular-starter": {
            "projectType": "application",
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:application",
                    "options": {
                        "outputPath": "dist",
                        "index": "index.html",
                        "browser": "src/main.ts",
                        "polyfills": ["zone.js"],
                        "tsConfig": "tsconfig.json",
                        "assets": [],
                        "styles": ["src/demo.css"]
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                { "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }
                            ],
                            "outputHashing": "all"
                        },
                        "development": {
                            "optimization": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "configurations": {
                        "production": { "buildTarget": "langsys-angular-starter:build:production" },
                        "development": { "buildTarget": "langsys-angular-starter:build:development" }
                    },
                    "defaultConfiguration": "development"
                }
            }
        }
    }
}

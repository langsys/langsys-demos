# Optional — leave this file uncopied and the app runs on the shared Langsys
# demo project: a READ-ONLY key with a fixed, pre-translated catalog. Existing
# phrases translate; anything you add or edit won't.
#
# To watch discovery register + translate YOUR phrases: copy to `.env.local`
# and use your own project id. The server key can be a WRITE key — it never
# leaves the server. The NEXT_PUBLIC_ one ships to the browser, so it must be
# READ-ONLY.
LANGSYS_PROJECT_ID=your-project-id-here
LANGSYS_API_KEY=your-server-api-key-here
NEXT_PUBLIC_LANGSYS_API_KEY=your-read-only-api-key-here

# Optional: point both halves at a non-production instance for local
# development. Leave unset in production — it defaults to
# https://api.langsys.dev/api.
# NEXT_PUBLIC_LANGSYS_API_URL=http://langsys-nova.test/api

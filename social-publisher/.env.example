# Copy to .env and fill in only the channels you post to.
# `social-publish auth youtube|linkedin --write` fills these in for you.

# YouTube: an OAuth client (Desktop app) from Google Cloud, and a refresh token
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# X: the app's API key and secret, and an access token and secret generated
# AFTER the app's permissions were set to "Read and write"
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Raise to 25000 for an account with X Premium
X_MAX_CHARS=280

# LinkedIn: an access token, and who posts: urn:li:person:<id> or urn:li:organization:<id>
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR=
LINKEDIN_VERSION=202609
# Only needed by `social-publish auth linkedin`
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Campaign tags: links to these domains (and their subdomains) get
# utm_source=<channel>&utm_campaign=...; leave empty to post links as written
UTM_DOMAINS=
UTM_CAMPAIGN=
# Hosts never tagged, e.g. API endpoints
UTM_EXCLUDE=

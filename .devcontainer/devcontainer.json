{
    // Repo-default dev container = the Laravel demo, so the green
    // "Code → Create codespace" button works identically to the README
    // badge (which pins .devcontainer/laravel/ explicitly). The JS demos
    // don't need a container — their one-click path is StackBlitz.
    "name": "Langsys × Laravel demo",
    "build": { "dockerfile": "laravel/Dockerfile" },
    "postCreateCommand": "cd laravel && composer install --no-interaction && cp -n .env.example .env && php artisan key:generate",
    // Serve on every container start. setsid+nohup put the server in its own
    // session — a plain `( … & )` child gets reaped when the lifecycle
    // command's shell exits (observed: empty log, no process).
    "postStartCommand": "bash -lc 'cd laravel && nohup setsid php artisan serve --host=0.0.0.0 --port=8000 > /tmp/laravel-serve.log 2>&1 < /dev/null &'",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "Laravel demo",
            "onAutoForward": "openPreview"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": ["bmewburn.vscode-intelephense-client"]
        }
    }
}

APP_NAME="Langsys Laravel demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# BCP 47 form so the untouched default matches the demo's en-US locale pill
# (and the interpolator's number/date formatting).
APP_LOCALE=en-US
APP_FALLBACK_LOCALE=en-US
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# file drivers so the demo needs no database at all — clone and serve.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Langsys ---------------------------------------------------------------
# Optional — leave these unset and the app runs on the shared Langsys demo
# project (the read-only fallback in config/langsys.php): existing phrases
# translate; anything you add or edit won't, because read-only keys can't
# register tokens.
#
# To watch discovery register + translate YOUR phrases: set your own project
# id with a WRITE key. Unlike the browser demos, a write key is fine here —
# it stays on the server and is never shipped to visitors. New phrases are
# registered after the response is sent (FlushPendingRegistrations).
LANGSYS_API_KEY=
LANGSYS_PROJECT_ID=

# Optional: point the SDK at a non-production instance for local development
# (e.g. a Laragon nova instance). Leave unset in production — it defaults to
# https://api.langsys.dev/api.
# LANGSYS_API_URL=http://langsys-nova.test/api

# Optional — leave this file uncopied and the app runs on the shared Langsys
# demo project: a READ-ONLY key with a fixed, pre-translated catalog. Existing
# phrases translate; anything you add or edit won't.
#
# To watch discovery register + translate YOUR phrases: copy to `.env` and use
# your own project id. NUXT_LANGSYS_API_KEY stays on the server and can be a
# WRITE key. The NUXT_PUBLIC_ one ships to the browser, so it must be READ-ONLY.
NUXT_PUBLIC_LANGSYS_PROJECT_ID=your-project-id-here
NUXT_LANGSYS_API_KEY=your-server-api-key-here
NUXT_PUBLIC_LANGSYS_API_KEY=your-read-only-api-key-here

# Optional: point both halves at a non-production instance for local
# development. Leave unset in production — it defaults to
# https://api.langsys.dev/api.
# NUXT_PUBLIC_LANGSYS_API_URL=http://langsys-nova.test/api
